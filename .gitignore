# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
dist/
build/
.venv/
venv/
env/
.ipynb_checkpoints/
*.ipynb
# ...except the canonical, deliberately-committed notebooks this project actually
# ships (notebooks/*.ipynb) -- the blanket rule above is for scratch/exploratory
# notebooks elsewhere, not these. A new file under notebooks/ silently failed to be
# tracked once already because `git add -A` skips gitignored paths without erroring;
# this exception exists specifically so that can't happen again.
!notebooks/*.ipynb

*.egg/

# Data & weights (never commit raw scans or trained models)
data/*
!data/*.py
!data/__init__.py
datasets/
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx

# Medical image files (keep out of git)
*.dcm
*.nii
*.nii.gz

# Fetched test samples (downloaded on demand by scripts/fetch_samples.py)
samples/
results/
# Logs / outputs
runs/
logs/
outputs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
.claude/

# Vendored OHIF viewer (viewer/ohif/) — source is committed per the chosen
# "vendor as subdirectory" layout, but build artifacts/dependencies are not.
viewer/ohif/**/node_modules/
viewer/ohif/**/dist/
viewer/ohif/**/.rspack-cache/
viewer/ohif/**/.webpack-cache/
viewer/ohif/.pnpm-store/
viewer/ohif/*.tsbuildinfo
