{
  "Name": "doctor_assistant-orthanc",
  "StorageDirectory": "${DOCTOR_ASSISTANT_ORTHANC_STORAGE}",
  "Plugins": ["${DOCTOR_ASSISTANT_ORTHANC_DICOMWEB_PLUGIN}"],
  "HttpPort": 8042,
  "DicomServerEnabled": false,
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "doctor_assistant": "doctor_assistant"
  },
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado"
  }
}
